# Archil — lager, der overlever mellem kørsler (se tools/archil.mjs)
# Kopiér til .env og udfyld. .env er gitignored og må ikke lægges op.

# API-nøgle fra https://console.archil.com/api-keys (starter med key-).
# IKKE en disk- eller mount-token (adt_…) — den giver 401.
ARCHIL_API_KEY=

# Regionen nøglen er lavet i. Standard: aws-us-east-1.
ARCHIL_REGION=aws-us-east-1

# Id på disken (dsk-…). Tom = check'en opretter en ny og skriver id-et ud.
ARCHIL_DISK_ID=
